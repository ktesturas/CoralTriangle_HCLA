#===============================================================================
# 00_Dependencies
# Shared libraries, paths, and project setup
#===============================================================================
# Load required packages
library(here)
library(dplyr)
library(sf)
library(ggplot2)
library(patchwork)
# Set project directory
project_dir <- here::here()
# Optional: set working directory to project root
setwd(project_dir)
# Define common folders
data_dir    <- file.path(project_dir, "Data")
scripts_dir <- file.path(project_dir, "Scripts")
out_dir     <- file.path(project_dir, "Outputs")
rds_dir     <- file.path(out_dir, "RDS")
figures_dir <- file.path(out_dir, "Figures")
# Specific output folders
rds_dir3 <- file.path(rds_dir, "03_Create_Features")
# Quick check
message("Project directory set to: ", project_dir)
message("Current working directory: ", getwd())
# Load shared dependencies and project paths
library(here)
source(here::here("Scripts", "00_Dependencies.R"))
# Set output directories
script_name <- "04_Plot_Metrics"
fig_dir <- file.path(out_dir, "Figures", script_name)
rds_dir <- file.path(out_dir, "RDS", script_name)
# Set filepaths for RDS
rds_dir1 <- file.path(out_dir, "RDS", "01_Setup_PUs")  # to retrieve PUs
dir.create(fig_dir, recursive = TRUE, showWarnings = FALSE)
dir.create(rds_dir, recursive = TRUE, showWarnings = FALSE)
# Load packages
pacman::p_load(tidyverse, sf, terra, here, purrr, rnaturalearth, parallel, patchwork, cmocean)
library(dplyr)
# Load datasets
PUs <- readRDS(file = file.path(rds_dir1, "PUs.rds"))
scenarios <- c("ssp126", "ssp245", "ssp585")
variables <- c("tos", "mhw")
for(variable in variables){
for (scenario in scenarios){
df <- readRDS(file = file.path("Data", "Metrics", paste0(variable, "_", scenario, "_roc.rds")))
colnames(df)[2] <- paste0(names(df)[2], "_", scenario)
assign(paste0(variable,"_",scenario), df, envir = .GlobalEnv)
}
}
landmass <- rnaturalearth::ne_countries(scale = "medium", returnclass = "sf")
sf::st_bbox(tos_ssp126)
sf::st_bbox(mhw_ssp126)
sf::st_crs(tos_ssp126)
bbox_wgs84 <- tos_ssp126 |>
sf::st_transform(4326) |>
sf::st_bbox()
print(bbox_wgs84)
bbox_wgs84 <- mhw_ssp126 %>%
sf::st_transform(4326) %>%
sf::st_bbox()
print(bbox_wgs84)
# Load shared dependencies and project paths
library(here)
source(here::here("Scripts", "00_Dependencies.R"))
# Set output directories
script_name <- "03_Create_Features"
fig_dir <- file.path(out_dir, "Figures", script_name)
rds_dir <- file.path(out_dir, "RDS", script_name)
# Set filepaths for RDS
rds_dir1 <- file.path(out_dir, "RDS", "01_Setup_PUs")  # to retrieve PUs
rds_dir2 <- file.path(out_dir, "RDS", "02_Load_Shp")  # to retrieve shapefiles/biodiversity data
dir.create(fig_dir, recursive = TRUE, showWarnings = FALSE)
dir.create(rds_dir, recursive = TRUE, showWarnings = FALSE)
# Load libraries
library(spatialplanr) # devtools::install_github("MathMarEcol/spatialplanr")
library(oceandatr)
library(tidyverse)
library(sf)
library(spatialgridr)
# Load Planning Region
PUs <- readRDS(file = file.path(rds_dir1, "PUs.rds"))
# Load Extent Datasets
Coral <- readRDS(file = file.path(rds_dir2, "Coral_Ext.rds")) %>%
sf::st_sf() %>%
dplyr::select(geometry)
# Load IUCN Datasets
IUCN_Coral <- readRDS(file = file.path(rds_dir2, "IUCN_Coral.rds")) %>%
sf::st_sf() %>%
dplyr::mutate(sci_name = stringr::str_replace_all(sci_name, " ", "_"))
# Interpolate Extent Data onto PUs
out <- Coral %>%
sf::st_intersection(PUs) %>%
dplyr::mutate(Coral_area_km2 = as.numeric(units::set_units(sf::st_area(.), "km2"))) %>%
dplyr::group_by(cellID) %>%
dplyr::summarise(Coral_area_km2 = sum(Coral_area_km2),
.groups = "drop_last") %>%
sf::st_drop_geometry() %>%
dplyr::left_join(PUs, ., by = "cellID")
out <- Coral %>%
sf::st_intersection(PUs) %>%
dplyr::mutate(Coral_area_km2 = as.numeric(units::set_units(sf::st_area(.), "km2"))) %>%
sf::st_drop_geometry() %>%
dplyr::group_by(cellID) %>%
dplyr::summarise(Coral_area_km2 = sum(Coral_area_km2),
.groups = "drop_last") %>%
dplyr::left_join(PUs, ., by = "cellID")
out_Coral <- out[!is.na(out$Coral_area_km2), ]
saveRDS(out_Coral, file = file.path(rds_dir, "out_Coral.rds"))
View(out)
out <- IUCN_Coral %>%
sf::st_crop(sf::st_bbox(out)) %>%
sf::st_make_valid() %>%
sf::st_cast("POLYGON") %>%
sf::st_intersection(out %>% filter(Coral_area_km2 > 0)) %>%
dplyr::mutate(IUCNCoral_area_km2 = as.numeric(units::set_units(sf::st_area(.), "km2"))) %>%
sf::st_drop_geometry() %>%
dplyr::group_by(cellID) %>%
dplyr::summarise(IUCNCoral_area_km2 = sum(IUCNCoral_area_km2),
.groups = "drop_last") %>%
dplyr::left_join(out, ., by = "cellID")
out <- IUCN_Coral %>%
sf::st_make_valid() %>%
sf::st_crop(sf::st_bbox(out)) %>%
sf::st_cast("POLYGON") %>%
sf::st_intersection(out %>% filter(Coral_area_km2 > 0)) %>%
dplyr::mutate(IUCNCoral_area_km2 = as.numeric(units::set_units(sf::st_area(.), "km2"))) %>%
sf::st_drop_geometry() %>%
dplyr::group_by(cellID) %>%
dplyr::summarise(IUCNCoral_area_km2 = sum(IUCNCoral_area_km2),
.groups = "drop_last") %>%
dplyr::left_join(out, ., by = "cellID")

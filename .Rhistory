breaks = breaks,  # Set the breaks for the legend scale
guide = guide_colourbar(title.position = "top", title.hjust = 0.5, barwidth = 20, barheight = 1)
) +  # Change color scale if needed
geom_sf(data = landmass, fill = "grey30", color = "black") +  # Overlay landmass for context
coord_sf(xlim = st_bbox(PUs)$xlim, ylim = st_bbox(PUs)$ylim, expand = TRUE) +
scale_y_continuous(
breaks = seq(-90, 90, by = 10),  # Set breaks every 10 degrees
labels = function(y) {
ifelse(y == 0, "0°",
ifelse(y > 0, paste0(y, "°N"), paste0(abs(y), "°S")))
}
) +# Set y-axis intervals by 10
# labs(title = "Coral Species Richness") +
theme_minimal() +
theme_bw() +
theme(
axis.text = element_text(color = "black", size = 18),
axis.title = element_text(size = 27),
plot.title = element_text(size = 27, hjust = 0.5), # Center and enlarge the plot title
legend.position = "bottom",  # Move the legend to the right
legend.title = element_text(size = 22, hjust = 0, margin = margin(b = 5)),  # Move the legend title to the left
legend.text = element_text(size = 22, hjust = 0.5),   # Center legend text
#  legend.direction = "vertical",
#   legend.box = "vertical",
legend.key.width = unit(3.50, "cm"),
legend.key.height = unit(0.50, "cm"),
legend.box.margin = margin(l = -10),  # Move the legend box to the right
strip.text = element_text(size = 27),  # Increase facet label text size
plot.margin = margin(t = 20, r = 40, b = 20, l = 20)  # Add margin around the plot to avoid cutting off axis text
)
spp_rich
ggsave(
filename = file.path(fig_dir, "Species_Richness.png"),
plot     = spp_rich,
width    = 9,
height   = 6,
dpi      = 300
)
